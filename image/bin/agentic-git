#!/usr/bin/env bash
# Git push credentials and commit identity for the project, written to .agentic/.env the way git
# reads them natively (GIT_CONFIG_* and GIT_AUTHOR_*/GIT_COMMITTER_*). Values are never shown.
# Usage: agentic-git login [URL] [--token-var VAR] [--user NAME] [--name N] [--email E] [--no-check]
# URL defaults to the origin of /work. The GIT_CONFIG_* entries for the URL's host are replaced;
# other entries are kept and renumbered. The token stays in VAR: the helper reads it when git runs.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
AGENTIC_DIR="${AGENTIC_DIR:-$(cd "$here/.." && pwd)}"
# shellcheck source=../lib/common.sh
source "$AGENTIC_DIR/lib/common.sh"
# shellcheck source=../lib/gitenv.sh
source "$AGENTIC_DIR/lib/gitenv.sh"
work="${AGENTIC_WORK:-/work}"; envf="$work/.agentic/.env"
MARK='# git config entries (agentic-git login; git reads them natively)'

usage() {
  echo "usage: agentic-git login [URL] [--token-var VAR] [--user NAME] [--name N] [--email E] [--no-check]" >&2
  exit 2
}
fail2() { echo "agentic-git: $*" >&2; exit 2; }

[ "${1:-}" = login ] || usage
shift
url="" var="" user="" name="" email="" check=1
while [ "$#" -gt 0 ]; do
  case "$1" in
    --token-var|--user|--name|--email)
      [ "$#" -ge 2 ] || usage
      case "$1" in --token-var) var="$2" ;; --user) user="$2" ;; --name) name="$2" ;; --email) email="$2" ;; esac
      shift ;;
    --no-check) check=0 ;;
    -*) usage ;;
    *) [ -z "$url" ] || usage; url="$1" ;;
  esac
  shift
done

if [ -z "$url" ]; then
  url="$(git -C "$work" remote get-url origin 2>/dev/null)" \
    || fail2 "no origin in $work; pass the URL: agentic-git login https://host/group/repo.git"
fi
host="$(url_host "$url")"
[[ "$host" =~ ^[A-Za-z0-9.-]+(:[0-9]+)?$ ]] || fail2 "cannot read a host from the URL"
case "$host" in
  github.com) : "${var:=GH_TOKEN}" "${user:=x-access-token}" ;;
  *gitlab*) : "${var:=GITLAB_TOKEN}" "${user:=oauth2}" ;;
esac
if [ -z "$var" ] || [ -z "$user" ]; then
  fail2 "$host is neither github.com nor a GitLab host: pass --token-var VAR (the .env key holding the token) and --user NAME (the user name the host expects with a token)"
fi
[[ "$var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || fail2 "--token-var must be a variable name"
[[ "$user" =~ ^[A-Za-z0-9._@-]+$ ]] || fail2 "--user may hold only letters, digits and . _ @ -"

# the entries for this host: reset any inherited helper, then ours; ssh is rewritten to https
helper="credential.https://$host.helper"
keys=("$helper" "$helper")
# shellcheck disable=SC2016 # expanded by git's shell when the helper runs
vals=("" "!f() { test \"\$1\" = get && echo username=$user && echo \"password=\$$var\"; }; f")
case "$url" in
  ssh://*|[!/]*@*:*)
    keys+=("url.https://$host/.insteadOf" "url.https://$host/.insteadOf")
    vals+=("git@$host:" "ssh://git@$host/") ;;
esac

# the other entries already in .env, in their order; ours for this host are dropped
mkdir -p "$(dirname "$envf")"
if [ ! -f "$envf" ]; then (umask 077; : > "$envf"); fi
okeys=() ovals=()
count="$(sed -n 's/^GIT_CONFIG_COUNT=//p' "$envf" | tail -n 1)"
[[ "$count" =~ ^[0-9]+$ ]] || count=0
for ((i = 0; i < count; i++)); do
  k="$(sed -n "s/^GIT_CONFIG_KEY_$i=//p" "$envf" | tail -n 1)"
  v="$(sed -n "s/^GIT_CONFIG_VALUE_$i=//p" "$envf" | tail -n 1)"
  case "$k" in
    ""|"$helper"|"credential.https://$host.username"|"url.https://$host/.insteadOf") continue ;;
  esac
  okeys+=("$k"); ovals+=("$v")
done
allk=("${okeys[@]}" "${keys[@]}"); allv=("${ovals[@]}" "${vals[@]}")

tmp="$(mktemp "$envf.XXXXXX")"
{
  grep -vE '^GIT_CONFIG_(COUNT|KEY_[0-9]+|VALUE_[0-9]+)=' "$envf" | grep -vxF "$MARK" || true
  echo "$MARK"
  echo "GIT_CONFIG_COUNT=${#allk[@]}"
  for i in "${!allk[@]}"; do
    printf 'GIT_CONFIG_KEY_%s=%s\nGIT_CONFIG_VALUE_%s=%s\n' "$i" "${allk[$i]}" "$i" "${allv[$i]}"
  done
} > "$tmp"
cat "$tmp" > "$envf"; rm -f "$tmp"
echo "wrote git credentials for $host to .agentic/.env: user $user, token from $var"

# identity: the host's (passed in by agentic) wins; else .env; else --name/--email
names="$(sed -nE 's/^([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' "$envf")"
if [ -n "${GIT_AUTHOR_NAME:-}" ] && [ -n "${GIT_AUTHOR_EMAIL:-}" ]; then
  echo "commit identity: $GIT_AUTHOR_NAME <$GIT_AUTHOR_EMAIL>"
elif grep -qx GIT_AUTHOR_NAME <<<"$names" && grep -qx GIT_AUTHOR_EMAIL <<<"$names"; then
  echo "commit identity: set in .agentic/.env"
elif [ -n "$name" ] && [ -n "$email" ]; then
  for k in GIT_AUTHOR_NAME GIT_COMMITTER_NAME; do "$AGENTIC_DIR/bin/agentic-env" add "$k" "$name" >/dev/null; done
  for k in GIT_AUTHOR_EMAIL GIT_COMMITTER_EMAIL; do "$AGENTIC_DIR/bin/agentic-env" add "$k" "$email" >/dev/null; done
  echo "commit identity: $name <$email>, written to .agentic/.env"
else
  echo "no commit identity: set user.name and user.email in git on the host, or pass --name \"Your Name\" --email you@example.com"
fi

# the token: from the environment, else from .env (a container started before it was added)
tok="${!var:-}"
if [ -z "$tok" ]; then tok="$(sed -n "s/^$var=//p" "$envf" | tail -n 1)"; fi
if [ -z "$tok" ] || is_placeholder "$tok"; then
  grep -qx "$var" <<<"$names" || "$AGENTIC_DIR/bin/agentic-env" add "$var" --comment "token for git on $host, with read and write access to the repositories" >/dev/null
  echo "agentic-git: put the token in $var in .agentic/.env (needs write access), then run this again" >&2
  exit 1
fi
[ "$check" = 1 ] || exit 0

if err="$(
  export GIT_CONFIG_COUNT="${#allk[@]}" GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes'
  for i in "${!allk[@]}"; do export "GIT_CONFIG_KEY_$i=${allk[$i]}" "GIT_CONFIG_VALUE_$i=${allv[$i]}"; done
  export "$var=$tok"
  git ls-remote "$url" HEAD 2>&1 >/dev/null
)"; then
  echo "ok    git access to $host (read checked; pushing needs a token with write access)"
  echo "      the container reads .agentic/.env at start: restart it (agentic dev recreate) to use it"
else
  redact_url "$err" >&2
  echo "agentic-git: $(redact_url "$url") cannot be read with the token in $var; check the token and its access" >&2
  exit 1
fi
