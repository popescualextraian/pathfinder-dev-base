#!/usr/bin/env bash
# Builds, mirrors and checks the project wiki in docs/wiki/; the deterministic half of /wiki.
# Usage: agentic-wiki [-C DIR] build | sync | check | affected <git diff range>
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
AGENTIC_DIR="${AGENTIC_DIR:-$(cd "$here/.." && pwd)}"
# shellcheck source=../lib/wiki.sh
source "$AGENTIC_DIR/lib/wiki.sh"
usage() { echo "usage: agentic-wiki [-C DIR] build | sync | check | affected <git diff range>" >&2; exit 2; }

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
if [ "${1:-}" = -C ]; then
  [ "$#" -ge 2 ] || usage
  ROOT="$(cd "$2" && pwd)"; shift 2
fi
need_wiki() { [ -d "$ROOT/$WIKI_DIR" ] || { echo "agentic-wiki: no $WIKI_DIR in $ROOT" >&2; exit 2; }; }

# --- build -------------------------------------------------------------------------------------

build_index() {
  local overview="" more="- [Decisions](decisions/index.md), [Reuse](reuse.md)"
  if [ -f "$ROOT/$WIKI_DIR/overview.md" ]; then
    overview="$(wiki_authored "$ROOT/$WIKI_DIR/overview.md" | { grep -v '^# ' || true; } | sed '/./,$!d')"
  fi
  printf '%s\n# Project wiki\n\n' "$WIKI_GEN_NOTE"
  printf '%s\n' "What the code does not tell: components, decisions, concepts and flows. Paths are relative to" \
    "docs/wiki/. Read a component's page before you change it. The code wins over the wiki; never" \
    "guess a page id."
  if [ -n "$overview" ]; then printf '\n%s\n' "$overview"; fi
  jq -r '
    def line: "- [\(.fm.name // .id)](\(.id).md): \(.fm.summary // "")";
    def section($t; $xs): if ($xs | length) > 0 then "\n## \($t)\n\n" + ($xs | map(line) | join("\n")) else empty end;
    section("Components"; map(select(.fm.kind == "component" and (.fm.parent // null) == null))),
    section("Concepts"; map(select(.fm.kind == "concept"))),
    section("Flows"; map(select(.fm.kind == "flow")))' <<<"$1"
  if [ -f "$ROOT/$WIKI_DIR/glossary.md" ]; then more+=", [Glossary](glossary.md)"; fi
  printf '\n## More\n\n%s\n' "$more"
}

build_decisions() {
  printf '%s\n# Decisions\n\n' "$WIKI_GEN_NOTE"
  jq -r '[.[] | select(.fm.kind == "decision")]
    | sort_by((.id | capture("adr-(?<n>[0-9]+)$") // {n: "0"}).n | tonumber)
    | if length == 0 then "No decisions recorded yet."
      else map("- [\(.fm.title // .id)](\(.id | ltrimstr("decisions/")).md): \(.fm.status // "")") | join("\n") end' <<<"$1"
}

build_reuse() {
  printf '%s\n# Reuse\n\nFunctions the components offer for reuse. Check here before you write a helper.\n\n' "$WIKI_GEN_NOTE"
  jq -r '[.[] | select(.fm.kind == "component") as $c
      | ($c.fm.offers | if type == "array" then .[] else empty end) | select(type == "object")
      | {name: (.name // ""), location: (.location // ""), use: (.use // ""), cid: $c.id, cname: ($c.fm.name // $c.id)}]
    | sort_by(.name)
    | if length == 0 then "No reusable functions recorded yet."
      else (["| Function | Location | Use | Component |", "|---|---|---|---|"]
        + map("| \(.name) | `\(.location)` | \(.use) | [\(.cname)](\(.cid).md) |")) | join("\n") end' <<<"$1"
}

# build_used_by MODEL: each component page gets its sub-components ("Parts") and the reverse of
# depends_on ("Used by").
build_used_by() {
  local id path dir u name summary content
  while IFS=$'\t' read -r id path; do
    dir="$(dirname "$ROOT/$path")"
    content=""
    while IFS=$'\t' read -r u name summary; do
      content+="- [$name]($(realpath -m --relative-to="$dir" "$ROOT/$WIKI_DIR/$u.md")): $summary"$'\n'
    done < <(jq -r --arg id "$id" '.[] | select(.fm.kind == "component" and .fm.parent == $id)
      | [.id, (.fm.name // .id), (.fm.summary // "")] | @tsv' <<<"$1")
    if [ -n "$content" ]; then content="## Parts"$'\n\n'"${content%$'\n'}"; fi
    wiki_put_block "$ROOT/$path" parts <<<"$content"
    content=""
    while IFS=$'\t' read -r u name; do
      content+="- [$name]($(realpath -m --relative-to="$dir" "$ROOT/$WIKI_DIR/$u.md"))"$'\n'
    done < <(jq -r --arg id "$id" '.[] | select(.fm.depends_on | if type == "array" then any(.[]; . == $id) else false end)
      | [.id, (.fm.name // .id)] | @tsv' <<<"$1")
    if [ -n "$content" ]; then content="## Used by"$'\n\n'"${content%$'\n'}"; fi
    wiki_put_block "$ROOT/$path" used-by <<<"$content"
  done < <(jq -r '.[] | select(.fm.kind == "component") | [.id, .path] | @tsv' <<<"$1")
}

cmd_build() {
  local model
  model="$(wiki_model)"
  mkdir -p "$ROOT/$WIKI_DIR/decisions"
  build_index "$model" > "$ROOT/$WIKI_DIR/index.md"
  build_decisions "$model" > "$ROOT/$WIKI_DIR/decisions/index.md"
  build_reuse "$model" > "$ROOT/$WIKI_DIR/reuse.md"
  build_used_by "$model"
  echo "built $WIKI_DIR/index.md, decisions/index.md, reuse.md and the Parts and Used by blocks"
}

# --- sync --------------------------------------------------------------------------------------

# cmd_sync: mirrors .claude/rules to .github/instructions (only files it generated are ever
# removed) and puts the index into .github/copilot-instructions.md, keeping the text around it.
cmd_sync() {
  local src rel out globs
  declare -A keep=()
  if [ -d "$ROOT/.claude/rules" ]; then
    while IFS= read -r src; do
      globs="$(rule_globs "$src")"
      if [ -z "$globs" ]; then continue; fi
      rel="${src#"$ROOT/.claude/rules/"}"
      out="$ROOT/$(rule_mirror "$rel")"
      keep["$out"]=1
      if [ -e "$out" ] && ! grep -q '^<!-- Generated by agentic-wiki sync' "$out"; then
        echo "agentic-wiki: left ${out#"$ROOT"/} alone: it is hand-written; move its content into .claude/rules/$rel and delete it"
        continue
      fi
      mkdir -p "$ROOT/.github/instructions"
      { printf -- '---\napplyTo: "%s"\n---\n' "$globs"
        printf '<!-- Generated by agentic-wiki sync from .claude/rules/%s. Do not edit. -->\n' "$rel"
        wiki_body "$src"; } > "$out"
    done < <(find "$ROOT/.claude/rules" -type f -name '*.md' | LC_ALL=C sort)
  fi
  if [ -d "$ROOT/.github/instructions" ]; then
    for out in "$ROOT"/.github/instructions/*.instructions.md; do
      if [ -e "$out" ] && [ -z "${keep[$out]:-}" ] && grep -q '^<!-- Generated by agentic-wiki sync' "$out"; then
        rm -- "$out"
      fi
    done
  fi
  if [ -f "$ROOT/$WIKI_DIR/index.md" ]; then
    mkdir -p "$ROOT/.github"
    tail -n +2 "$ROOT/$WIKI_DIR/index.md" | wiki_put_block "$ROOT/.github/copilot-instructions.md" wiki-index
  fi
  echo "synced .github/instructions and .github/copilot-instructions.md"
}

# --- check -------------------------------------------------------------------------------------

stale_note() { echo "$1: generated content is stale; run agentic-wiki build and agentic-wiki sync"; }

# check_pages MODEL: front matter shape, kinds, required fields, allowed values, references.
check_pages() {
  jq -r '
    def kind_for: if startswith("components/") then "component"
      elif test("^decisions/adr-[0-9]+$") then "decision"
      elif startswith("concepts/") then "concept"
      elif startswith("flows/") then "flow"
      elif . == "overview" or . == "glossary" then .
      else null end;
    def required: {component: ["name", "summary", "lifecycle", "status", "sources"],
      decision: ["title", "status"], concept: ["name", "summary"], flow: ["name", "summary"],
      overview: [], glossary: []};
    def known($ids): . as $r | ($r | type) == "string" and any($ids[]; . == $r);
    def bad_offer: if type != "object" then true else (.name == null or .location == null or .use == null) end;
    (map(.id)) as $ids
    | .[] | . as $p | ($p.id | kind_for) as $k | $p.fm as $fm
    | if $k == null then "\($p.path): not a page location of the wiki"
      elif $fm == null then "\($p.path): missing or invalid front matter"
      else
        (if $fm.kind != $k then "\($p.path): kind must be \($k)" else empty end),
        (if $fm.id != $p.id then "\($p.path): id must be \($p.id)" else empty end),
        ((required | .[$k])[] | . as $f | select($fm | .[$f] == null) | "\($p.path): missing \($f)"),
        (["sources", "depends_on", "decisions", "offers", "related", "components"][] | . as $f
          | select(($fm | .[$f]) != null and ($fm | .[$f] | type) != "array") | "\($p.path): \($f) must be a list"),
        (if $k == "component" and $fm.status != null and ($fm.status | IN("draft", "reviewed") | not)
          then "\($p.path): status must be draft or reviewed" else empty end),
        (if $k == "component" and $fm.lifecycle != null and ($fm.lifecycle | IN("active", "migrating", "retiring") | not)
          then "\($p.path): lifecycle must be active, migrating or retiring" else empty end),
        (if $k == "decision" and $fm.status != null and ($fm.status | IN("proposed", "accepted", "superseded") | not)
          then "\($p.path): status must be proposed, accepted or superseded" else empty end),
        (if ($fm.offers | type) == "array" and any($fm.offers[]; bad_offer)
          then "\($p.path): every offer needs name, location and use" else empty end),
        (["depends_on", "decisions", "related", "components"][] as $f
          | ($fm | .[$f] | if type == "array" then .[] else empty end)
          | select(known($ids) | not) | "\($p.path): \($f) names unknown page \(.)"),
        (["parent", "superseded_by"][] as $f | ($fm | .[$f] // empty)
          | select(known($ids) | not) | "\($p.path): \($f) names unknown page \(.)")
      end' <<<"$1"
}

# check_sources MODEL: every source and offer location exists; no source is claimed twice.
check_sources() {
  local path src e name loc
  declare -A claimed=()
  while IFS=$'\t' read -r path src; do
    e="${src%/}"
    if [ ! -e "$ROOT/$e" ]; then echo "$path: source $src does not exist"; fi
    if [ -n "${claimed[$e]:-}" ]; then
      echo "$path: source $src is also claimed by ${claimed[$e]}"
    else
      claimed[$e]="$path"
    fi
  done < <(jq -r '.[] | select(.fm.kind == "component") | .path as $p
      | (.fm.sources | if type == "array" then .[] else empty end) | select(type == "string") | [$p, .] | @tsv' <<<"$1")
  while IFS=$'\t' read -r path name loc; do
    if [ ! -e "$ROOT/${loc%%::*}" ]; then echo "$path: offer $name points at missing ${loc%%::*}"; fi
  done < <(jq -r '.[] | select(.fm.kind == "component") | .path as $p
      | (.fm.offers | if type == "array" then .[] else empty end) | select(type == "object" and .location != null)
      | [$p, (.name // ""), .location] | @tsv' <<<"$1")
}

# check_links MODEL: relative links in authored text resolve to a file in the repository.
check_links() {
  local path dir target
  while IFS= read -r path; do
    dir="$(dirname "$ROOT/$path")"
    while IFS= read -r target; do
      case "$target" in *://*|mailto:*|'#'*) continue ;; esac
      target="${target%%#*}"
      if [ ! -e "$dir/$target" ]; then echo "$path: broken link $target"; fi
    done < <(wiki_authored "$ROOT/$path" | grep -oE '\]\([^)[:space:]]+\)' | sed -E 's/^\]\((.*)\)$/\1/' || true)
  done < <(jq -r '.[].path' <<<"$1")
}

# check_limits MODEL: page size (non-blank, non-heading lines), tables and path lists, the index.
check_limits() {
  local path kind limit n
  while IFS=$'\t' read -r path kind; do
    case "$kind" in
      component) limit=80 ;;
      concept|flow) limit=60 ;;
      overview) limit=10 ;;
      *) continue ;;
    esac
    n="$(wiki_authored "$ROOT/$path" | grep -cvE '^[[:space:]]*(#.*)?$' || true)"
    if [ "$n" -gt "$limit" ]; then echo "$path: $n lines, limit $limit"; fi
    if [ "$kind" != component ]; then continue; fi
    n="$(wiki_authored "$ROOT/$path" | awk '/^\|/ { run++; if (run - 2 > max) max = run - 2; next } { run = 0 } END { print max + 0 }')"
    if [ "$n" -gt 10 ]; then echo "$path: table with $n rows, limit 10; leave inventories to the code"; fi
    # shellcheck disable=SC2016 # literal Markdown backticks, not command substitution
    n="$(wiki_authored "$ROOT/$path" | grep -cE '`[^`[:space:]]*/[^`[:space:]]*`' || true)"
    if [ "$n" -gt 10 ]; then echo "$path: $n lines name paths, limit 10; leave inventories to the code"; fi
  done < <(jq -r '.[] | select(.fm != null) | [.path, (.fm.kind // "")] | @tsv' <<<"$1")
  if [ -f "$ROOT/$WIKI_DIR/index.md" ]; then
    n="$(wc -l < "$ROOT/$WIKI_DIR/index.md")"
    if [ "$n" -gt 70 ]; then echo "$WIKI_DIR/index.md: $n lines, limit 70; group components under parents"; fi
  fi
}

# check_context: CLAUDE.md imports the index and stays small; every rule has paths.
check_context() {
  local f n m
  if [ ! -f "$ROOT/CLAUDE.md" ]; then
    echo "CLAUDE.md: missing; it must import the wiki index"
  else
    n="$(wc -l < "$ROOT/CLAUDE.md")"
    if [ "$n" -gt 130 ]; then echo "CLAUDE.md: $n lines, limit 130"; fi
    if ! tr -d '\r' < "$ROOT/CLAUDE.md" | grep -qxF '@docs/wiki/index.md'; then echo "CLAUDE.md: no @docs/wiki/index.md line"; fi
  fi
  if [ ! -d "$ROOT/.claude/rules" ]; then return 0; fi
  while IFS= read -r f; do
    if [ -z "$(rule_globs "$f")" ]; then echo "${f#"$ROOT"/}: a rule without paths belongs in CLAUDE.md"; continue; fi
    m="$(rule_mirror "${f#"$ROOT/.claude/rules/"}")"
    if [ -e "$ROOT/$m" ] && ! grep -q '^<!-- Generated by agentic-wiki sync' "$ROOT/$m"; then
      echo "$m: hand-written file has the name of the mirror of ${f#"$ROOT"/}; move its content into the rule and delete it"
    fi
  done < <(find "$ROOT/.claude/rules" -type f -name '*.md' | LC_ALL=C sort)
}

# check_generated: build and sync on a copy must reproduce the generated files byte for byte.
check_generated() {
  local tmp f
  tmp="$(mktemp -d)"
  mkdir -p "$tmp/docs" "$tmp/.claude"
  cp -r "$ROOT/$WIKI_DIR" "$tmp/docs/"
  if [ -d "$ROOT/.claude/rules" ]; then cp -r "$ROOT/.claude/rules" "$tmp/.claude/"; fi
  if [ -d "$ROOT/.github" ]; then cp -r "$ROOT/.github" "$tmp/"; fi
  if ! bash "${BASH_SOURCE[0]}" -C "$tmp" build >/dev/null 2>&1 \
     || ! bash "${BASH_SOURCE[0]}" -C "$tmp" sync >/dev/null 2>&1; then
    echo "$WIKI_DIR: could not rebuild the generated files; run agentic-wiki build to see why"
    rm -rf "$tmp"
    return 0
  fi
  # Line endings do not count: a CRLF checkout of LF files is not stale.
  while IFS= read -r f; do
    if [ ! -f "$ROOT/$f" ] || ! cmp -s <(tr -d '\r' < "$tmp/$f") <(tr -d '\r' < "$ROOT/$f"); then stale_note "$f"; fi
  done < <(cd "$tmp" && find "$WIKI_DIR" .github -type f 2>/dev/null | LC_ALL=C sort)
  if [ -d "$ROOT/.github/instructions" ]; then
    while IFS= read -r f; do
      if [ ! -e "$tmp/$f" ]; then stale_note "$f"; fi
    done < <(cd "$ROOT" && { grep -lr '^<!-- Generated by agentic-wiki sync' .github/instructions || true; } | LC_ALL=C sort)
  fi
  rm -rf "$tmp"
}

cmd_check() {
  local model n=0 line
  if [ ! -d "$ROOT/$WIKI_DIR" ]; then echo "agentic-wiki: no $WIKI_DIR; nothing to check"; return 0; fi
  model="$(wiki_model)"
  while IFS= read -r line; do
    if [ -z "$line" ]; then continue; fi
    echo "$line"; n=$((n + 1))
  done < <(check_pages "$model"; check_sources "$model"; check_links "$model"; check_limits "$model"
           check_context; check_generated)
  if [ "$n" -gt 0 ]; then echo "agentic-wiki: $n problem(s)" >&2; return 1; fi
  echo "wiki: ok"
}

# --- affected ----------------------------------------------------------------------------------

# cmd_affected RANGE: maps the files git diff lists to the component with the longest matching
# source; omitted.yaml paths print as omitted, the rest as unclaimed.
cmd_affected() {
  local files f e best id src
  declare -A owner=()
  files="$(git -C "$ROOT" diff --name-only "$1")" || exit 2
  while IFS=$'\t' read -r id src; do
    owner["${src%/}"]="$id"
  done < <(wiki_model | jq -r '.[] | select(.fm.kind == "component") | .id as $i
      | (.fm.sources | if type == "array" then .[] else empty end) | select(type == "string") | [$i, .] | @tsv')
  if [ -f "$ROOT/$WIKI_DIR/omitted.yaml" ]; then
    while IFS= read -r e; do
      if [ -n "$e" ]; then owner["${e%/}"]="-"; fi
    done < <(yq -r '.paths[]?.path // ""' "$ROOT/$WIKI_DIR/omitted.yaml")
  fi
  while IFS= read -r f; do
    case "$f" in
      ""|"$WIKI_DIR"/*|.claude/*|.github/instructions/*|.github/copilot-instructions.md|CLAUDE.md) continue ;;
    esac
    best=""
    for e in "${!owner[@]}"; do
      if [ "$f" = "$e" ] || [[ "$f" == "$e"/* ]]; then
        if [ "${#e}" -gt "${#best}" ]; then best="$e"; fi
      fi
    done
    if [ -z "$best" ]; then
      echo "unclaimed $f"
    elif [ "${owner[$best]}" = - ]; then
      echo "omitted $f"
    else
      echo "component ${owner[$best]} $f"
    fi
  done <<<"$files"
}

# --- dispatch ----------------------------------------------------------------------------------

cmd="${1:-}"; [ "$#" -gt 0 ] && shift
case "$cmd" in
  build) need_wiki; cmd_build ;;
  sync) need_wiki; cmd_sync ;;
  check) cmd_check ;;
  affected) need_wiki; [ "$#" -eq 1 ] || usage; cmd_affected "$1" ;;
  *) usage ;;
esac
