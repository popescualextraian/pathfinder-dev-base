#!/usr/bin/env bash
# Host CLI for agentic-dev-base. Run `agentic help`.
set -euo pipefail
AGENTIC_ROOT="${AGENTIC_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
# shellcheck source=../lib/host/common.sh
source "$AGENTIC_ROOT/lib/host/common.sh"
# shellcheck source=../lib/host/detect.sh
source "$AGENTIC_ROOT/lib/host/detect.sh"
# shellcheck source=../lib/host/layout.sh
source "$AGENTIC_ROOT/lib/host/layout.sh"
# shellcheck source=../lib/host/task.sh
source "$AGENTIC_ROOT/lib/host/task.sh"
# shellcheck source=../lib/host/schedule.sh
source "$AGENTIC_ROOT/lib/host/schedule.sh"
# shellcheck source=../lib/host/setup.sh
source "$AGENTIC_ROOT/lib/host/setup.sh"

usage() {
  cat <<'EOF'
agentic <command> [options]          run inside a project repository
  init [--force] [--bare] [--base IMAGE] | init --env-example
                                     write .agentic/ for this repository, with detected tools and the
                                     recommended setup lines (--bare: none; --base: an overlay's);
                                     --env-example restores a missing .env.example template
  build [--refresh] [--no-cache]
                                     build the base if needed, then agentic-<project>:local
  login [claude|copilot]             log a harness in for this project (once)
  login git [URL] [--token-var VAR] [--user U] [--name N --email E]
                                     git push credentials and identity in .agentic/.env, then a check
  setup                              refine .agentic/ with the /agentic-setup skill
  shell [CMD...]                     throwaway container (removed on exit)
  doctor                             check the configured container: steps, tools, logins, MCP, certificates
  dev [stop|recreate|status] [--host-profile wsl|none]
                                     persistent dev container, attached through tmux (detach: Ctrl-b d)
  target [NAME]                      the default repository of a multi-repository project
  run "prompt" [--target T] [--in ID] [--worktree] [--auto-clean] [--agent A] [--allow push|open-pr|deploy:T]... [--id ID] [--json]
                                     start a detached task in a new container (or in task ID's); prints its id
  status [ID] [--all] [--json]       list tasks, or one task with its open questions
  follow ID [--since N] [--raw]      stream a running task's events until it waits, idles or ends
  send ID "text"                     a new prompt (starts a suspended task)
  answer ID [QID] "text" [--allow A]...
                                     answer the oldest (or the named) open question; grants unblock the gate
  cancel ID | stop ID | resume ID    end the turn | end the task | continue an interrupted or failed task
  logs ID [--transcript|--bridge|--start]
  shell ID                           a shell in the running task container
  takeover ID                        stop the task and continue its session interactively
  clean ID [--force]                 remove what the task created: worktree and branch, its container, its files
  schedule add NAME (--cron "M H DOM MON DOW" | --at "YYYY-MM-DD HH:MM") [--allow A]... [--agent A] [--model M]
               [--target T] [--no-worktree] [--keep] [--keep-on-failure] [--timeout 2h] "prompt"
                                     run a detached task from your crontab; it ends with a summary and is cleaned up
  schedule list [--json] | remove NAME | run NAME | results NAME [--all]
  schedule follow NAME [--since N] [--raw]
                                     stream the running firing of NAME until its run ends
  add marketplace|plugin|mcp|skill|agent|command|workspace ... [--target T] [--no-build] [--yes]
  copy SRC DEST | mount SRC DEST [--readonly] | volume NAME DEST
                                     add a setup line (docs/setup.md), then build
  remove KIND KEY [--target T]       delete setup lines, then build
  list                               the built-in mounts, then the setup lines with their phase
  build-base [--force]               build agentic-dev-base:local (make build)
EOF
}

# base_hash: a hash of everything the base image is built from.
base_hash() {
  (cd "$AGENTIC_ROOT" && find image derive config schema skills templates marketplace -type f -print0 | sort -z \
    | xargs -0 sha256sum | sha256sum | cut -c1-16)
}

cmd_build_base() {
  local h; h="$(base_hash)"
  if [ "${1:-}" != --force ] && [ "$(image_label "$BASE_IMAGE" agentic.base.hash)" = "$h" ]; then
    echo "base image is current"; return 0
  fi
  proxy_build_args
  local ca="${AGENTIC_BUILD_CA_DIR:-$AGENTIC_DATA/ca}" ctx=()
  if compgen -G "$ca/*.crt" >/dev/null; then ctx=(--build-context "agentic-ca=$ca"); fi
  docker build -f "$AGENTIC_ROOT/image/Dockerfile" "${PROXY_BUILD_ARGS[@]}" "${ctx[@]}" \
    --label "agentic.base.hash=$h" -t "$BASE_IMAGE" "$AGENTIC_ROOT"
}

cmd_build() {
  local refresh=0 nocache=() cfg base img
  while [ $# -gt 0 ]; do
    case "$1" in
      --refresh) refresh=1 ;;
      --no-cache) nocache=(--no-cache) ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  need_config
  cmd_build_base
  cfg="$(cfg_dir)"; base="$(base_image_of)"; img="$(project_image)"
  image_exists "$base" || die "base image $base not found; build or pull it first"
  check_env_file "$cfg/.env"
  mkdir -p "$cfg/.build"
  if ! docker run --rm --entrypoint /opt/agentic/derive/render-dockerfile.sh \
       -v "$cfg:/agentic-config:ro" "$base" > "$cfg/.build/Dockerfile.derived"; then
    die "agentic.yaml has errors (see above)"
  fi
  # BuildKit reads <Dockerfile>.dockerignore next to the -f file: secrets never reach the context.
  printf '%s\n' .env '.env.*' '!.env.example' .build/ > "$cfg/.build/Dockerfile.derived.dockerignore"
  local args=(-f "$cfg/.build/Dockerfile.derived" --build-arg "UID=$(id -u)" --build-arg "GID=$(id -g)" -t "$img")
  if [ "$refresh" = 1 ]; then args+=(--build-arg "AGENTIC_SETUP_REFRESH=$(date +%s)"); fi
  proxy_build_args
  docker build "${nocache[@]}" "${PROXY_BUILD_ARGS[@]}" "${args[@]}" "$cfg"
  echo "built $img"
}

# yaml_str TEXT: TEXT as a YAML scalar, single-quoted unless it is plainly safe.
yaml_str() {
  if [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9\ _@%+=,./~:-]*$ && "$1" != *": "* && "$1" != *: ]]; then printf '%s\n' "$1"
  else printf "'%s'\n" "${1//\'/\'\'}"; fi
}

# folder_lines ROOT: an `add workspace` line per repository of multi-layout ROOT whose origin is a
# remote URL (credentials stripped), so a missing one is cloned into /work at start. The origin is
# read from the repository's config file (origin_url), never with git.
folder_lines() {
  local r url n
  while IFS= read -r r; do
    url="$(origin_url "$1/$r" | sed -E 's#(://)[^/@]+@#\1#')"
    case "$url" in https://*|ssh://*|git@*:*) ;; *) continue ;; esac
    n="${url%/}"; n="${n##*[/:]}"; n="${n%.git}"
    if [ "$n" = "$r" ]; then printf 'add workspace %s\n' "$url"; else printf 'add workspace %s --name %s\n' "$url" "$r"; fi
  done < <(repo_dirs "$1")
}

# recommended_lines [IMAGE]: the recommended setup lines, from IMAGE (an overlay's, else the base's
# file in it) or from this checkout; comments and blank lines dropped.
recommended_lines() {
  if [ -n "${1:-}" ]; then
    docker run --rm --entrypoint sh "$1" -c 'cat /opt/agentic/defaults/recommended 2>/dev/null || cat /opt/agentic/config/recommended' \
      || die "could not read the recommended setup lines from $1"
  else cat "$AGENTIC_ROOT/config/recommended"; fi | sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d'
}

# make_cfg DIR: mkdir -p DIR. When that fails although DIR is not there, a deleted DIR is still held
# open (Windows keeps the name until the last handle closes): name the running containers that mount it.
make_cfg() {
  local held
  mkdir -p "$1" && return 0
  [ ! -e "$1" ] && [ ! -L "$1" ] || exit 1
  held="$(docker ps -q 2>/dev/null | xargs -r docker inspect -f '{{range .Mounts}}{{$.Name}}{{"\t"}}{{.Source}}{{"\n"}}{{end}}' 2>/dev/null |
    awk -F '\t' -v d="$1" '$2 == d || index($2, d "/") == 1 { sub(/^\//, "", $1); print $1 }' | sort -u || true)"
  {
    echo "agentic: $1 does not exist but its name is still held open, so it cannot be created again"
    if [ -n "$held" ]; then
      echo "  a running container still mounts it; remove it, then run this again:"
      while IFS= read -r c; do echo "    docker rm -f $c"; done <<<"$held"
    else
      echo "  close whatever still uses it (a container, an editor, a shell inside it), then run this again"
    fi
  } >&2
  exit 1
}

# init_layout_notes ROOT LAYOUT REPOS: what init found about the folder and what that means.
init_layout_notes() {
  local root="$1" r sib
  case "$2" in
    single)
      sib="$(repo_dirs "$(dirname "$root")" | grep -vxF -- "$(basename "$root")" | comma_list || true)"
      if [ -n "$sib" ]; then
        echo "note: $(dirname "$root") also holds the repositories $sib;"
        echo "  to work on them together, run agentic init in $(dirname "$root")"
      fi ;;
    multi)
      echo "workspace folder with the repositories $3 (mounted together at /work)"
      while IFS= read -r r; do
        if [ -d "$root/$r/.agentic" ]; then
          echo "warning: $r/.agentic is not read in a workspace folder; move what is needed up to $root/.agentic"
        fi
      done < <(repo_dirs "$root") ;;
  esac
}

cmd_init() {
  local force=0 bare=0 base="" envx=0 root cfg det name line files rec r layout tgt layout_line repos wsl
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --bare) bare=1 ;;
      --base) optval "$@"; base="$2"; shift ;;
      --env-example) envx=1 ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  root="$(project_root)"; cfg="$root/.agentic"
  if [ "$envx" = 1 ]; then
    if [ -e "$cfg/.env.example" ]; then echo ".agentic/.env.example exists; left unchanged"; return 0; fi
    make_cfg "$cfg"
    cp "$AGENTIC_ROOT/templates/dot-agentic/.env.example" "$cfg/.env.example"
    echo "wrote $cfg/.env.example"; return 0
  fi
  if [ -f "$cfg/agentic.yaml" ] && [ "$force" = 0 ]; then
    die ".agentic/agentic.yaml already exists; use --force to overwrite it"
  fi
  layout="$(detect_layout "$root")"
  [ -n "$layout" ] || die "no git repository in $root or its direct subfolders; run agentic init in a repository or a folder of repositories"
  tgt=""
  if [ "$layout" = multi ] && [ "$(repo_dirs "$root" | grep -c .)" = 1 ]; then tgt="$(repo_dirs "$root")"; fi
  make_cfg "$cfg"
  # the skeleton never overwrites a file that is already there
  (cd "$AGENTIC_ROOT/templates/dot-agentic" && find . -type f) | while IFS= read -r line; do
    if [ ! -e "$cfg/$line" ]; then
      mkdir -p "$cfg/$(dirname "$line")"
      cp "$AGENTIC_ROOT/templates/dot-agentic/$line" "$cfg/$line"
    fi
  done
  det="$(detect_tools "$root")"
  name="$(slugify "$(basename "$root")")"
  repos="$(repo_dirs "$root" | comma_list)"
  case "$layout" in
    single) layout_line="single (one repository)" ;;
    *) layout_line="multi, a workspace folder ($repos); target: ${tgt:-not set}" ;;
  esac
  if [ "$bare" = 0 ]; then rec="$(recommended_lines "$base")"; else rec=""; fi
  wsl=""; if [ "$layout" = multi ]; then wsl="$(folder_lines "$root")"; fi
  while IFS= read -r line; do
    case "$line" in
      @TOOLS@) render_tools "$det" ;;
      @LAYOUT@) printf 'layout: %s\n' "$layout"; if [ -n "$tgt" ]; then printf 'target: %s\n' "$tgt"; fi ;;
      @BASE@) if [ -n "$base" ]; then printf 'base_image: %s\n' "$base"; fi ;;
      @SETUP@)
        if [ -z "$rec$wsl" ]; then echo 'setup: []'
        else
          echo 'setup:'
          if [ -n "$wsl" ]; then
            echo '  # the repositories of this folder: a missing one is cloned into /work/<name> at start'
            while IFS= read -r r; do printf '  - %s\n' "$(yaml_str "$r")"; done <<<"$wsl"
          fi
          if [ -n "$rec" ]; then
            echo '  # recommended (delete a line to drop it)'
            while IFS= read -r r; do printf '  - %s\n' "$(yaml_str "$r")"; done <<<"$rec"
          fi
        fi ;;
      *) printf '%s\n' "${line//@PROJECT@/$name}" ;;
    esac
  done < "$AGENTIC_ROOT/templates/agentic.yaml.tmpl" > "$cfg/agentic.yaml"
  {
    echo "# Detection report ($(date -u +%Y-%m-%d))"
    echo
    echo "Layout: $layout_line"
    echo
    echo "Build files found:"
    files="$(report_files "$root")"
    sed -n '1,50s/^/- /p' <<<"$files"
    echo
    echo "Detected:"; grep -v '^note=' <<<"$det" | sed 's/^/- /' || true
    echo
    echo "Notes:"; grep '^note=' <<<"$det" | sed 's/^note=/- /' || true
  } > "$cfg/detect-report.md"
  echo "wrote $cfg/agentic.yaml"
  init_layout_notes "$root" "$layout" "$repos"
  if [ "$layout" = multi ] && [ -z "$tgt" ]; then echo "note: $(target_hint "$root")"; fi
  # the harness homes belong to the project name, not to .agentic/: a re-init finds them again
  if [ -d "$AGENTIC_DATA/projects/$name/harness" ]; then
    echo "note: $AGENTIC_DATA/projects/$name holds the data of an earlier project named $name;"
    echo "  its logins, sessions and history are reused. To start fresh, delete its harness/ folder"
    echo "  (docs/setup.md, \"Where things live\")."
  fi
  echo "next: review it, then run: agentic build && agentic login && agentic dev"
}

# run_image: the project image, or the base with a notice before the first build.
run_image() {
  local img; img="$(project_image)"
  if image_exists "$img"; then printf '%s\n' "$img"; return 0; fi
  say "$img not built yet; using $(base_image_of) (run agentic build)"
  base_image_of
}

cmd_shell() {
  need_config
  local img tty=(-i)
  img="$(run_image)"
  if [ -t 0 ] && [ -t 1 ]; then tty=(-it); fi
  build_run_args "$img"
  host_args
  docker run --rm "${tty[@]}" "${RUN_ARGS[@]}" "${HOST_ARGS[@]}" "$img" "$@"
}

# login_file F: a harness login file's content, only when it is a regular file and no symlink, read
# with read_agent_file (a dev agent can write the harness homes).
login_file() { if [ -f "$1" ] && [ ! -L "$1" ]; then read_agent_file "$1"; fi; }

# harness_authenticated claude|copilot: a login on disk or a token in .env.
harness_authenticated() {
  local h="$1" data env
  data="$AGENTIC_DATA/projects/$(project_name)/harness/$h"; env="$(cfg_dir)/.env"
  case "$h" in
    claude)
      [ -n "$(login_file "$data/.credentials.json")" ] \
        || [ -n "$(token_value "$env" ANTHROPIC_API_KEY)$(token_value "$env" CLAUDE_CODE_OAUTH_TOKEN)$(token_value "$env" CLAUDE_CODE_USE_BEDROCK)" ] ;;
    copilot)
      [ -n "$(token_value "$env" COPILOT_GITHUB_TOKEN)$(token_value "$env" GH_TOKEN)" ] \
        || login_file "$data/config.json" | tr -d '[:space:]' | grep -q '"logged_in_users":\[{' ;;
    *) return 1 ;;
  esac
}

auth_help() {
  cat >&2 <<EOF
agentic: $1 is not authenticated for $(project_name). Pick one:
  Claude   subscription   agentic login claude      (then /login inside, then /exit)
           subscription   CLAUDE_CODE_OAUTH_TOKEN=... in .agentic/.env (the token from claude setup-token)
           API key        ANTHROPIC_API_KEY=sk-ant-api... in .agentic/.env (pay per use; never a subscription token)
           Bedrock        CLAUDE_CODE_USE_BEDROCK=1 and AWS_PROFILE=... in .agentic/.env
  Copilot  device login   agentic login copilot     (then /login inside, then /exit)
           token          COPILOT_GITHUB_TOKEN=... (or GH_TOKEN) in .agentic/.env, GH_HOST for Enterprise
EOF
}

cmd_login() {
  need_config
  local h="${1:-claude}" img tty=(-i)
  case "$h" in claude|copilot|git) ;; *) die "usage: agentic login [claude|copilot|git]" ;; esac
  img="$(run_image)"
  if [ "$h" = git ]; then
    # push credentials and identity into .env, written by the image's agentic-git
    shift
    if [ -t 0 ] && [ -t 1 ]; then tty=(-it); fi
    build_run_args "$img"
    docker run --rm "${tty[@]}" "${RUN_ARGS[@]}" "$img" agentic-git login "$@"
    return
  fi
  if harness_authenticated "$h"; then say "$h already has a login or token for $(project_name); starting it anyway"; fi
  echo "Starting $h. Run /login, follow the instructions, then /exit. The login is kept for this project."
  build_run_args "$img"
  host_args
  docker run --rm -it "${RUN_ARGS[@]}" "${HOST_ARGS[@]}" "$img" "$h"
}

cmd_setup() {
  need_config
  local img h
  img="$(run_image)"
  h="$(image_label "$img" agentic.harness)"
  case "$h" in claude|copilot) ;; *) h=claude ;; esac
  if ! harness_authenticated "$h"; then auth_help "$h"; exit 1; fi
  build_run_args "$img"
  if [ "$h" = copilot ]; then set -- copilot -i "/agentic-setup"; else set -- claude "/agentic-setup"; fi
  host_args
  docker run --rm -it "${RUN_ARGS[@]}" "${HOST_ARGS[@]}" -e AGENTIC_SETUP=1 "$img" "$@"
}

# host_args [wsl]: host conveniences for interactive containers, in HOST_ARGS. On WSL with WSLg: the
# display, the Wayland clipboard (Claude Code pastes images through wl-paste) and the host /tmp
# (PyCharm pastes an image as a path to a file there). Detected automatically, forced with "wsl";
# AGENTIC_HOST_PROFILE=none turns it off. Tasks never need any of it.
host_args() {
  local wslg="${AGENTIC_WSLG_DIR:-/mnt/wslg/runtime-dir}"
  HOST_ARGS=()
  if [ "${AGENTIC_HOST_PROFILE:-auto}" = none ]; then return 0; fi
  if [ "${1:-}" = wsl ] || [ -S "$wslg/wayland-0" ]; then
    HOST_ARGS=(-e DISPLAY=:0 -e WAYLAND_DISPLAY=/run/wslg/wayland-0 -e TMUX_TMPDIR=/home/dev
      -v "$wslg:/run/wslg" -v /tmp:/tmp)
  fi
}

dev_start() {
  local name="$1" img="$2" wsl="$3"
  image_exists "$img" || die "$img is not built; run agentic build"
  build_run_args "$img"
  if [ "$wsl" = 1 ]; then host_args wsl; else host_args; fi
  docker run -d --name "$name" --restart unless-stopped --label agentic.kind=dev \
    "${RUN_ARGS[@]}" "${HOST_ARGS[@]}" "$img" sleep infinity >/dev/null
}

dev_status() {
  local name="$1" img="$2" running cur latest
  if ! running="$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null)"; then
    echo "$name: not created"; return 0
  fi
  cur="$(docker inspect -f '{{.Image}}' "$name" 2>/dev/null || true)"
  latest="$(docker image inspect -f '{{.Id}}' "$img" 2>/dev/null || true)"
  echo "$name: running=$running image=$img"
  if [ -n "$latest" ] && [ "$cur" != "$latest" ]; then echo "outdated: $img was rebuilt; run agentic dev recreate"; fi
}

cmd_dev() {
  need_config
  local action=attach wsl=0 name img
  while [ $# -gt 0 ]; do
    case "$1" in
      attach|stop|recreate|status) action="$1" ;;
      --host-profile)
        case "${2:-}" in
          wsl) wsl=1 ;;
          none) export AGENTIC_HOST_PROFILE=none ;;
          *) die "--host-profile takes wsl or none" ;;
        esac
        shift ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  name="agentic-$(project_name)-dev"; img="$(project_image)"
  case "$action" in
    stop) docker stop "$name" >/dev/null; echo "stopped $name" ;;
    status) dev_status "$name" "$img" ;;
    recreate)
      docker rm -f "$name" >/dev/null 2>&1 || true
      dev_start "$name" "$img" "$wsl"
      docker exec -it "$name" dev-shell ;;
    attach)
      case "$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null || true)" in
        true) ;;
        false) docker start "$name" >/dev/null ;;
        *) dev_start "$name" "$img" "$wsl" ;;
      esac
      docker exec -it "$name" dev-shell ;;
  esac
}

cmd_doctor() {
  need_config
  local img rc=0; img="$(run_image)"
  build_run_args "$img"
  docker run --rm "${RUN_ARGS[@]}" -e "AGENTIC_IMAGE_CONFIG_HASH=$(image_label "$img" agentic.config.hash)" "$img" agentic-doctor || rc=$?
  sched_doctor || rc=1
  return "$rc"
}

optval() { [ -n "${2:-}" ] || die "$1 needs a value"; }

# run_cleanup: the EXIT trap of cmd_run; rolls the task back until the run has succeeded.
run_cleanup() {
  if [ -n "${RUN_ROLLBACK_ID:-}" ] && [ "${RUN_KEEP:-0}" != 1 ]; then rollback_task "$RUN_ROLLBACK_ID" kill || true; fi
}

cmd_run() {
  need_config
  local prompt="" pfile="" agent="" model="" target="" in="" worktree=0 autoclean=0 id="" keep=0 json=0 sched="" allow=() a
  while [ $# -gt 0 ]; do
    case "$1" in
      --prompt-file) optval "$@"; pfile="$2"; shift 2 ;;
      --agent) optval "$@"; agent="$2"; shift 2 ;;
      --model) optval "$@"; model="$2"; shift 2 ;;
      --target) optval "$@"; target="$2"; shift 2 ;;
      --in) optval "$@"; in="$2"; shift 2 ;;
      --worktree) worktree=1; shift ;;
      --auto-clean) autoclean=1; shift ;;
      --allow) optval "$@"; allow+=("$2"); shift 2 ;;
      --id) optval "$@"; id="$2"; shift 2 ;;
      --keep-on-failure) keep=1; shift ;;
      --json) json=1; shift ;;
      --scheduled) optval "$@"; sched="$2"; shift 2 ;;
      -*) die "unknown option $1 (agentic help)" ;;
      *) [ -z "$prompt" ] || die "one prompt; quote it"; prompt="$1"; shift ;;
    esac
  done
  [ -z "$sched" ] || [[ "$sched" =~ ^[0-9]+$ ]] || die "--scheduled takes seconds"
  sweep_cleaned
  if [ -n "$pfile" ]; then
    [ -z "$prompt" ] || die "give either a prompt or --prompt-file"
    [ -f "$pfile" ] || die "no file $pfile"
    prompt="$(cat "$pfile")"
  fi
  [ -n "$prompt" ] || die 'run needs a prompt: agentic run "..." or --prompt-file F'
  [[ "$model" != *[[:cntrl:]]* ]] || die "--model must be one line without control characters"
  local img; img="$(run_image)"
  [ -n "$agent" ] || agent="$(image_label "$img" agentic.harness)"
  agent="${agent:-claude}"
  case "$agent" in claude|copilot) ;; *) die "--agent must be claude or copilot" ;; esac
  for a in ${allow[@]+"${allow[@]}"}; do valid_grant "$a" || die "unknown --allow $a (push, open-pr, deploy:<target>)"; done
  [ -n "$id" ] || id="$(new_task_id)"
  valid_task_id "$id" || die "the task id must match [A-Za-z0-9._-]+"
  if [ -e "$(task_dir "$id")" ] || [ -L "$(task_dir "$id")" ]; then die "task $id exists"; fi
  local work tname branch=""
  work="$(task_work "$target")" || exit 1
  tname="${work#/work}"; tname="${tname#/}"
  if [ "$worktree" = 1 ]; then branch="${AGENTIC_BRANCH_PREFIX:-agentic/}$id-$(task_slug "$prompt")"; fi
  local c created=1 creator="$id"
  if [ -n "$in" ]; then
    need_task "$in"
    c="$(task_container "$in")"; creator="$(task_creator "$in")" || die "task $in has no container record"; created=0
    case "$(container_status "$in")" in
      missing) die "task $in has no container" ;;
      unknown) die "docker did not answer for task $in" ;;
      running) ! bridge_running "$c" || die "a task runs in the container of $in; one task at a time per container (stop it first)" ;;
    esac
  else
    c="$(task_container "$id")"
    # a container of that name is not ours to use or to roll back
    case "$(container_status "$id")" in
      missing) ;;
      unknown) die "docker did not answer" ;;
      *) die "a container $c already exists; remove it or pick another --id" ;;
    esac
  fi
  check_cap

  # Everything that can refuse (the .env file, a missing mount source) runs before anything is created.
  local p ws dir data port v extra=()
  p="$(task_project)"; ws="$(task_ws)"; dir="$(task_dir "$id")"
  RUN_ARGS=()
  if [ "$created" = 1 ]; then project_run_args "$img"; fi
  # the agent can write the checkout and tasks/: a bind source that is or goes through a symlink is refused
  for v in "$ws" "$ws/tasks" "$ws/events"; do bind_src_ok "$v" || die "$v is a symlink or goes through one; refused"; done
  v="$(dotenv_value "$(project_root)/.agentic/.env" AGENTIC_GATE)"
  if [ -n "$v" ] && [ "$v" != 1 ]; then say "warning: .agentic/.env sets AGENTIC_GATE=$(printf '%s' "$v" | plain): the gate is off for every task"; fi

  # The task directory is made exclusively: tasks/ is shared with the other task containers, so
  # nothing in it is trusted to be ours, and files are written without following a link (noclobber).
  mkdir -p "$ws/tasks" "$ws/events"
  for v in "$ws/tasks" "$ws/events"; do bind_src_ok "$v" || die "$v is a symlink or goes through one; refused"; done
  mkdir "$dir" 2>/dev/null || die "task $id exists"
  # From here any failure, die or signal removes what was created (unless --keep-on-failure).
  RUN_ROLLBACK_ID="$id"; RUN_KEEP="$keep"
  trap run_cleanup EXIT; trap 'exit 130' INT; trap 'exit 143' TERM
  mkdir "$dir/home" "$dir/home/claude" "$dir/home/copilot"
  (umask 077; mkdir -p "$(task_hdir "$id")")
  for v in "${TASK_HOST_FILES[@]}"; do rm -f -- "$(task_file "$id" "$v")"; done
  (set -o noclobber; printf '%s\n' "$prompt" > "$dir/prompt.md")
  (umask 077; printf '%s\n%s\n%s\n' "$c" "$created" "$creator" > "$(task_file "$id" container)")
  (umask 077; {
    printf 'AGENTIC_TASK_TOKEN=%s\nAGENTIC_AGENT_TOKEN=%s\n' "$(new_token)" "$(new_token)"
    printf 'AGENTIC_TASK_ID=%s\nAGENTIC_TASK_DIR=/tasks/%s\nAGENTIC_PROJECT=%s\nAGENTIC_AGENT=%s\nAGENTIC_MODEL=%s\n' "$id" "$id" "$p" "$agent" "$model"
    printf 'AGENTIC_WORK=%s\nAGENTIC_TARGET=%s\nAGENTIC_CONTAINER=%s\nAGENTIC_CREATED_CONTAINER=%s\n' "$work" "$tname" "$c" "$created"
    printf 'AGENTIC_ALLOWED_ACTIONS=%s\nAGENTIC_WORKTREE=%s\nAGENTIC_BRANCH=%s\nAGENTIC_AUTO_CLEAN=%s\n' \
      "$(IFS=,; echo "${allow[*]+"${allow[*]}"}")" "$worktree" "$branch" "$autoclean"
    if [ -n "$sched" ]; then printf 'AGENTIC_SCHEDULED=1\nAGENTIC_RUN_TIMEOUT=%s\n' "$sched"; fi
    for v in AGENTIC_IDLE_TIMEOUT AGENTIC_NOTIFY_WEBHOOK AGENTIC_GATE_PROTECTED; do
      if [ -n "${!v:-}" ]; then printf '%s=%s\n' "$v" "${!v}"; fi
    done
  } > "$(task_file "$id" env)")
  host_file "$id" env >/dev/null || die "the env file of $id is not a regular file"
  if [ "$created" = 1 ]; then
    data="$AGENTIC_DATA/projects/$p/harness"
    for v in claude/.credentials.json copilot/config.json; do
      if [ -f "$data/$v" ] && [ ! -L "$data/$v" ]; then (umask 077; set -o noclobber; read_agent_file "$data/$v" > "$dir/home/$v"); fi
    done
    read -ra extra <<<"${AGENTIC_TASK_DOCKER_ARGS:-}"
    rm -f "$dir/.ready"
    docker run -d --init --name "$c" --cap-drop ALL --security-opt no-new-privileges --label agentic.kind=task --label "agentic.task=$id" \
      -p "127.0.0.1::$TASK_PORT" "${RUN_ARGS[@]}" -v "$ws/tasks:/tasks" -v "$ws/events:/events" -e "AGENTIC_TASK_DIR=/tasks/$id" \
      ${extra[@]+"${extra[@]}"} "$img" agentic-task-hold >/dev/null || die "docker run failed for $id"
    wait_ready "$id" "${AGENTIC_START_TIMEOUT:-120}" || {
      docker logs --tail 20 "$c" 2>&1 | plain >&2 || true
      die "the container of $id did not finish its start; see agentic logs $id --start"
    }
  elif [ "$(container_status "$id")" != running ]; then
    start_container "$id"
  fi
  start_bridge "$id"
  # with --auto-clean or --scheduled a quick task can end, and its container exit, before the host looks
  if ! wait_bridge "$id" "${AGENTIC_START_TIMEOUT:-120}" \
    && ! { [ "$autoclean" = 1 ] && [ "$(record_get "$id" .cleaned)" = true ]; } \
    && ! { [ -n "$sched" ] && [[ " stopped failed " == *" $(record_get "$id" .state) "* ]]; }; then
    # the bridge's own reason, before the rollback removes the task directory
    bridge_tails "$id"
    die "the bridge of $id did not come up"
  fi
  RUN_ROLLBACK_ID=""; trap - EXIT INT TERM
  port="$(task_port "$id" || true)"   # none when the container already exited (auto-clean)
  if [ "$json" = 1 ]; then
    jq -cn --arg t "$id" --arg c "$c" --arg p "$port" --arg tg "$tname" --arg b "$branch" \
      '{task: $t, container: $c, port: $p, target: (if $tg == "" then null else $tg end), branch: (if $b == "" then null else $b end)}'
  else
    echo "$id"
  fi
  echo "follow: agentic follow $id" >&2
}

cmd_status() {
  local all=0 json=0 id="" f st rows=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=1 ;;
      --json) json=1 ;;
      -*) die "unknown option $1" ;;
      *) id="$1" ;;
    esac
    shift
  done
  if [ -n "$id" ]; then
    need_config; need_task "$id"
    st="$(task_status_json "$id")"
    if [ "$json" = 1 ]; then printf '%s\n' "$st"; return; fi
    # c strips control characters (terminal escapes); qs and opts drop what is not a list of objects or values.
    jq -r --arg id "$id" 'def c: tostring | gsub("[[:cntrl:]]"; " ");
      def qs: .questions | if type == "array" then map(select(type == "object")) else [] end;
      def opts: .options | if type == "array" then . else [] end;
      "\($id)  \(.state | c)\(if (.reason // "") != "" then " (" + (.reason | c) + ")" else "" end)  \(.agent | c)  \(.branch // "" | c)",
      (if (.summary // "") != "" then "summary: " + (.summary | c) else empty end),
      (qs[] | "\(.id | c) (\(.source | c)): \(.text | c)\(if (opts | length) > 0 then " [" + (opts | map(c) | join(", ")) + "]" else "" end)\(if .recommendation then " recommended: " + (.recommendation | c) else "" end)"),
      (if (qs | length) > 0 then "reply: agentic answer \($id) \(qs[0].id | c) \"…\"" else empty end)' <<<"$st"
    return
  fi
  local files=()
  if [ "$all" = 1 ]; then
    files=("$AGENTIC_WORKSPACES"/*/tasks/*/state.json)
  else
    need_config
    sweep_cleaned
    files=("$(task_ws)"/tasks/*/state.json)
  fi
  for f in "${files[@]}"; do
    if ! { [ -f "$f" ] && [ ! -L "$f" ] && [ ! -L "$(dirname "$f")" ] && [ ! -L "$(dirname "$(dirname "$f")")" ]; }; then continue; fi
    # The project and id come from the directory layout; state.json is written by the agent.
    id="$(basename "$(dirname "$f")")"
    valid_task_id "$id" || continue
    rows+=("$(TASK_PROJECT="$(basename "$(dirname "$(dirname "$(dirname "$f")")")")" task_status_json "$id")")
  done
  if [ "$json" = 1 ]; then printf '%s\n' "${rows[@]}" | jq -s .; return; fi
  printf '%-18s %-11s %-8s %-9s %-5s %s\n' TASK STATE AGENT QUESTIONS AGE BRANCH
  for st in "${rows[@]}"; do
    [ -n "$st" ] || continue
    printf '%-18s %-11s %-8s %-9s %-5s %s\n' "$(jq -r '.task | tostring | gsub("[[:cntrl:]]"; " ")' <<<"$st")" \
      "$(jq -r '.state | tostring | gsub("[[:cntrl:]]"; " ")' <<<"$st")" "$(jq -r '.agent | tostring | gsub("[[:cntrl:]]"; " ")' <<<"$st")" \
      "$(jq -r '.questions | if type == "array" then length else 0 end' <<<"$st")" "$(age "$(jq -r '.created | tostring' <<<"$st")")" \
      "$(jq -r '.branch // "" | tostring | gsub("[[:cntrl:]]"; " ")' <<<"$st")"
  done
}

cmd_send() {
  need_config
  [ $# -eq 2 ] || die 'usage: agentic send ID "text"'
  need_task "$1"; ensure_running "$1"
  bridge_post "$1" /prompt "$(jq -cn --arg t "$2" '{text: $t}')"
}

cmd_answer() {
  need_config
  local id="" q="" text="" pos=() grants=() g
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; pos+=("$@"); break ;;
      --allow) optval "$@"; grants+=("$2"); shift 2 ;;
      -*) die "unknown option $1" ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  case "${#pos[@]}" in
    2) id="${pos[0]}"; text="${pos[1]}" ;;
    3) id="${pos[0]}"; q="${pos[1]}"; text="${pos[2]}" ;;
    *) die 'usage: agentic answer ID [QID] "text" [--allow A]...' ;;
  esac
  for g in ${grants[@]+"${grants[@]}"}; do valid_grant "$g" || die "bad grant '$g' (push, open-pr or deploy:TARGET)"; done
  need_task "$id"; ensure_running "$id"
  bridge_post "$id" /answer "$(jq -cn --arg q "$q" --arg t "$text" \
    '{text: $t, grant: $ARGS.positional} + (if $q == "" then {} else {question: $q} end)' --args ${grants[@]+"${grants[@]}"})"
}

cmd_cancel() {
  need_config; need_task "${1:-}"; need_running "$1"
  bridge_post "$1" /cancel
}

cmd_stop() {
  need_config; need_task "${1:-}"
  local id="$1" c; c="$(task_container "$1")"
  if [ "$(task_state "$id")" = stopped ]; then echo "$id: stopped"; return 0; fi
  ensure_running "$id"
  if bridge_req "$id" POST /stop; then
    [[ "$BRIDGE_CODE" == 2* ]] || bridge_result "$id"
    wait_bridge_gone "$c" "${AGENTIC_STOP_TIMEOUT:-30}" || say "the bridge of $id did not end; stopping its container"
  else
    say "the bridge of $id did not answer; stopping its container (the task will show interrupted)"
  fi
  ! foreign_bridge "$id" || die "another task runs in the container of $id; stop it first"
  docker stop "$c" >/dev/null || die "could not stop the container of $id"
  echo "$id: $(task_state "$id" | plain)"
}

cmd_resume() {
  need_config; need_task "${1:-}"
  local id="$1" st; st="$(task_state "$1")"
  case "$st" in
    interrupted|failed) ;;
    *) die "task $id is $st; resume is for interrupted or failed tasks (agentic send continues the others)" ;;
  esac
  ensure_running "$id"
  rm -f "$(task_file "$id" interrupted)"
  bridge_post "$id" /prompt "$(jq -cn '{text: "You were interrupted. Check git status and continue."}')"
}

cmd_logs() {
  need_config
  local id="" what=transcript a
  for a in "$@"; do
    case "$a" in
      --transcript) what=transcript ;; --bridge) what=bridge ;; --start) what=start ;;
      -*) die "unknown option $a" ;;
      *) id="$a" ;;
    esac
  done
  need_task "$id"
  case "$what" in
    transcript) if task_readable "$id" transcript.md; then task_read "$id" transcript.md | plain; else echo "(no transcript yet)"; fi ;;
    bridge) if task_readable "$id" bridge.log; then task_read "$id" bridge.log | plain; else echo "(no bridge log yet)"; fi
      if task_readable "$id" bridge.out; then echo "--- bridge.out (the bridge's own stdout and stderr)"; task_read "$id" bridge.out | plain; fi ;;
    start) docker logs "$(task_container "$id")" 2>&1 | plain ;;
  esac
}

cmd_follow() {
  need_config
  local id="${1:-}" envf; [ -n "$id" ] || die "usage: agentic follow ID [--since N] [--raw] [--forever]"
  shift; need_task "$id"
  [ "$(container_status "$id")" = running ] || die "task $id is $(task_state "$id" | plain); agentic logs $id shows its transcript"
  envf="$(host_file "$id" env)" || die "the env file of $id is not a regular file"
  # The token reaches the client through the host env file; none goes on a command line.
  local tty=(-i); if [ -t 0 ] && [ -t 1 ]; then tty=(-it); fi
  docker exec "${tty[@]}" --env-file "$envf" "$(task_container "$id")" agentic-bridge follow "$@"
}

cmd_task_shell() {
  need_config; need_task "${1:-}"; need_running "$1"
  docker exec -it "$(task_container "$1")" bash -l
}

cmd_takeover() {
  need_config; need_task "${1:-}"
  local id="$1" agent session c envf work argv=() tty=(-i)
  agent="$(record_get "$id" .agent)"; session="$(record_get "$id" .session)"; c="$(task_container "$id")"
  envf="$(host_file "$id" env)" || die "the env file of $id is not a regular file"
  [ -n "$session" ] || die "task $id has no session yet"
  case "$agent" in
    claude) argv=(claude --dangerously-skip-permissions --resume "$session") ;;
    copilot) argv=(copilot --allow-all "--resume=$session") ;;
    *) die "task $id has an unknown agent '$agent'" ;;
  esac
  # the directory from the host's own file, never from the record
  work="$(dotenv_value "$envf" AGENTIC_WORK)"
  if task_has_worktree "$id"; then work="$work/.worktrees/$id"; fi
  case "$(container_status "$id")" in
    running)
      if bridge_running "$c"; then
        ! foreign_bridge "$id" || die "another task runs in the container of $id; stop it first"
        bridge_req "$id" POST /stop >/dev/null 2>&1 || true
        wait_bridge_gone "$c" "${AGENTIC_STOP_TIMEOUT:-30}" || docker exec "$c" pkill -f 'bridge/dist/main\.js$' >/dev/null 2>&1 || true
      fi ;;
    missing) die "task $id has no container" ;;
    *) start_container "$id" ;;
  esac
  if [ -t 0 ] && [ -t 1 ]; then tty=(-it); fi
  echo "Taking over $id with $agent; the task stays stopped afterwards." >&2
  # docker exec skips the start's environment, so load the harness homes first.
  docker exec "${tty[@]}" -w "$work" -e "AGENTIC_TASK_DIR=/tasks/$id" "$c" \
    bash -c '[ ! -f "$HOME/.agentic/env" ] || . "$HOME/.agentic/env"; exec "$@"' bash "${argv[@]}"
}

cmd_clean() {
  need_config
  local id="" force=0 a c out
  for a in "$@"; do case "$a" in --force) force=1 ;; -*) die "unknown option $a" ;; *) id="$a" ;; esac; done
  need_task "$id"
  c="$(task_container "$id")"
  if [[ " $TASK_ACTIVE " == *" $(task_state "$id") "* ]]; then
    [ "$force" = 1 ] || die "task $id is running; run agentic stop $id first, or --force"
    if bridge_running "$c" && ! foreign_bridge "$id"; then
      bridge_req "$id" POST /stop >/dev/null 2>&1 || true
      if ! wait_bridge_gone "$c" "${AGENTIC_STOP_TIMEOUT:-30}"; then
        docker exec "$c" pkill -f 'bridge/dist/main\.js$' >/dev/null 2>&1 || true
        wait_bridge_gone "$c" 5 || true
      fi
    fi
  fi
  if task_created "$id" && [ "$(container_status "$id")" = running ] && bridge_running "$c"; then
    die "another task runs in the container of $id; stop it first"
  fi
  if task_has_worktree "$id"; then
    case "$(container_status "$id")" in
      running) ;;
      missing)
        [ "$force" = 1 ] || die "the container of $id is gone, so its worktree cannot be checked; run agentic clean $id --force"
        say "the container of $id is gone: remove .worktrees/$id and its branch in the checkout by hand" ;;
      *) start_container "$id" ;;
    esac
    if [ "$(container_status "$id")" = running ]; then
      if [ "$force" = 1 ]; then out="$(worktree_cmd "$id" remove --force 2>&1)" || die "$(printf '%s' "$out" | plain | tail -n 1)"
      else out="$(worktree_cmd "$id" remove 2>&1)" || die "$(printf '%s' "$out" | plain | tail -n 1 | sed 's/^agentic-worktree: //')"
      fi
    fi
  fi
  rollback_task "$id"
  echo "$id: removed (remote branches stay)"
}

cmd_schedule() {
  need_config
  local sub="${1:-}"; [ $# -eq 0 ] || shift
  case "$sub" in
    add) sched_add "$@" ;;
    list) sched_list "$@" ;;
    remove) sched_remove "$@" ;;
    run) sched_fire "${1:-}" now ;;
    fire) sched_fire "${1:-}" cron ;;
    results) sched_show "$@" ;;
    follow) sched_follow "$@" ;;
    *) die "usage: agentic schedule add|list|remove|run|results|follow ... (agentic help)" ;;
  esac
}

cmd_target() {
  need_config
  local root cfgf layout cur
  root="$(project_root)"; cfgf="$(cfg_dir)/agentic.yaml"
  layout="$(yaml_top "$cfgf" layout)"
  [ -n "$layout" ] || die "no layout in .agentic/agentic.yaml; re-run agentic init"
  [ $# -le 1 ] || die "usage: agentic target [NAME]"
  if [ $# -eq 0 ]; then
    if [ "$layout" = single ]; then echo "single repository: the agent starts in the project root"; return 0; fi
    cur="$(yaml_top "$cfgf" target)"
    echo "target: ${cur:-(none)}"
    echo "repositories: $(repo_dirs "$root" | paste -sd' ' -)"
    return 0
  fi
  [ "$layout" = multi ] || die "a single-repository project has no target to set"
  valid_target "$root" "$1" || die "$1 is not a repository of the project; choose one of: $(repo_dirs "$root" | paste -sd' ' -)"
  yaml_set_top "$cfgf" target "$1"
  echo "target: $1"
}

main() {
  local cmd="${1:-help}"
  if [ "$#" -gt 0 ]; then shift; fi
  case "$cmd" in
    add|copy|mount|volume) cmd_setup_line "$cmd" "$@" ;;
    shell) if [ "$#" -eq 1 ] && valid_task_id "$1" && [ -f "$(task_dir "$1" 2>/dev/null)/state.json" ]; then cmd_task_shell "$1"; else cmd_shell "$@"; fi ;;
    build-base) cmd_build_base "$@" ;;
    # each of these is handled by cmd_<command>
    init|remove|list|build|login|setup|doctor|dev|target|run|status|send|answer|cancel|stop|resume|logs|follow|takeover|clean|schedule)
      "cmd_$cmd" "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
