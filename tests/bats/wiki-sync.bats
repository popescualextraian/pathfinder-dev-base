#!/usr/bin/env bats
load helpers

setup() {
  WK="$REPO_ROOT/image/bin/agentic-wiki"
  wiki_repo
}

@test "sync mirrors each rule with applyTo and a generated note" {
  rm -rf "$W/.github"
  run "$WK" -C "$W" sync
  [ "$status" -eq 0 ]
  f="$W/.github/instructions/api.instructions.md"
  [ "$(sed -n 1,4p "$f")" = $'---\napplyTo: "src/api/**,infra/api.tf"\n---\n<!-- Generated by agentic-wiki sync from .claude/rules/api.md. Do not edit. -->' ]
  grep -qxF '# API rules' "$f"
}

@test "a rule in a subfolder gets a flat name and a single glob" {
  mkdir -p "$W/.claude/rules/infra"
  printf -- '---\npaths: "infra/**"\n---\n\n# Network\n' > "$W/.claude/rules/infra/network.md"
  run "$WK" -C "$W" sync
  grep -qxF 'applyTo: "infra/**"' "$W/.github/instructions/infra-network.instructions.md"
}

@test "a rule without paths is not mirrored" {
  printf '# Everywhere\n' > "$W/.claude/rules/general.md"
  run "$WK" -C "$W" sync
  [ "$status" -eq 0 ]
  [ ! -e "$W/.github/instructions/general.instructions.md" ]
}

@test "sync removes a mirror whose rule is gone and keeps hand-written instruction files" {
  run "$WK" -C "$W" sync
  rm "$W/.claude/rules/api.md"
  printf '# Mine\n' > "$W/.github/instructions/own.instructions.md"
  run "$WK" -C "$W" sync
  [ ! -e "$W/.github/instructions/api.instructions.md" ]
  [ "$(cat "$W/.github/instructions/own.instructions.md")" = '# Mine' ]
}

@test "sync puts the index into copilot-instructions.md, keeps the text around it, and is idempotent" {
  mkdir -p "$W/.github"
  printf '# Team notes\n\nUse the issue template.\n' > "$W/.github/copilot-instructions.md"
  run "$WK" -C "$W" sync
  [ "$status" -eq 0 ]
  c="$W/.github/copilot-instructions.md"
  [ "$(sed -n 1,3p "$c")" = $'# Team notes\n\nUse the issue template.' ]
  grep -qxF '<!-- generated:wiki-index:start -->' "$c"
  grep -qxF -- '- [API](components/api.md): Public HTTP API; owns the routes and their versioning.' "$c"
  run grep -F 'Generated by agentic-wiki build' "$c"
  [ "$status" -ne 0 ]
  cp "$c" "$BATS_TEST_TMPDIR/first"
  run "$WK" -C "$W" sync
  cmp "$BATS_TEST_TMPDIR/first" "$c"
}

@test "sync reproduces the committed .github of the fixture" {
  rm -rf "$W/.github"
  run "$WK" -C "$W" sync
  diff -r "$REPO_ROOT/tests/fixtures/wiki/good/dot-github" "$W/.github"
}

@test "sync never overwrites a hand-written instruction file with a mirror's name" {
  printf '# Mine\n' > "$W/.github/instructions/api.instructions.md"
  run "$WK" -C "$W" sync
  [ "$(cat "$W/.github/instructions/api.instructions.md")" = '# Mine' ]
  [[ "$output" == *"left .github/instructions/api.instructions.md alone: it is hand-written"* ]]
}

@test "sync keeps one index block in a copilot-instructions.md larger than a pipe buffer" {
  run "$WK" -C "$W" sync
  append_filler "$W/.github/copilot-instructions.md"
  run "$WK" -C "$W" sync
  [ "$status" -eq 0 ]
  [ "$(grep -c 'generated:wiki-index:start' "$W/.github/copilot-instructions.md")" = 1 ]
}
