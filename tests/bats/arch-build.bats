#!/usr/bin/env bats
load helpers

setup() {
  make_tmp_home
  export AGENTIC_DIR="$REPO_ROOT/image"
  ARCH="$REPO_ROOT/image/bin/agentic-arch"
  C="$REPO_ROOT/tests/fixtures/architect/contract"
  arch_repo
}

# snapshot DIR: every file with its checksum
snapshot() { (cd "$1" && find . -type f | LC_ALL=C sort | xargs sha256sum); }

@test "build reproduces the contract model" {
  rm "$A/docs/architecture/model.json" "$A/docs/architecture/index.md"
  run "$ARCH" -C "$A" build
  [ "$status" -eq 0 ]
  diff <(jq -S . "$A/docs/architecture/model.json") <(jq -S . "$C/model.json")
}

@test "a second build leaves the tree byte-identical" {
  "$ARCH" -C "$A" build
  before="$(snapshot "$A")"
  "$ARCH" -C "$A" build
  [ "$(snapshot "$A")" = "$before" ]
}

@test "the committed generated files are what build writes" {
  "$ARCH" -C "$A" build
  cmp "$A/docs/architecture/model.json" "$REPO_ROOT/tests/fixtures/architect/good/docs/architecture/model.json"
  cmp "$A/docs/architecture/index.md" "$REPO_ROOT/tests/fixtures/architect/good/docs/architecture/index.md"
}

@test "the index is short, generated, grouped and has no @" {
  "$ARCH" -C "$A" build
  i="$A/docs/architecture/index.md"
  [ "$(head -n 1 "$i")" = '<!-- Generated by agentic-arch build from the pages in docs/architecture/. Do not edit. -->' ]
  [ "$(wc -l < "$i")" -le 70 ]
  ! grep -q '@' "$i"
  grep -qF 'Read a component'"'"'s page before you change it.' "$i"
  grep -qxF -- '- [Order service](components/order-service.md): Owns orders: pricing, checkout, the payment step.' "$i"
  # under Backend > Orders > Service
  awk '/^### Backend/ { p = 1 } p && /^#### Orders/ { m = 1 } m && /^##### Service/ { l = 1 } l && /Order service/ { f = 1 } END { exit !f }' "$i"
  grep -qF 'Style: Modular monolith, layered.' "$i"
  grep -qF 'make-it-work, yagni, least-surprise, kiss, consistent, dry, clean-code, solid' "$i"
}

@test "component sources exist and the exception is the only layer break" {
  "$ARCH" -C "$A" build
  while IFS=$'\t' read -r src _; do [ -f "$A/$src" ]; done < <(source "$REPO_ROOT/image/lib/wiki.sh"; source "$REPO_ROOT/image/lib/arch.sh"; ROOT="$A"; arch_owners)
  grep -q 'layers/orders-api/imports-order-store' "$A/docs/architecture/architecture.md"
}

@test "a single part without modules builds with empty modules" {
  d="$BATS_TEST_TMPDIR/plain"; mkdir -p "$d/docs/architecture/components"
  cat > "$d/docs/architecture/architecture.md" <<'EOF'
---
style: layered
parts:
  - id: app
    name: App
    layers:
      - { id: web, name: Web, mayUse: [core] }
      - { id: core, name: Core, mayUse: [] }
principles: [kiss]
patterns: []
---

# Plain app
EOF
  cat > "$d/docs/architecture/components/pages.md" <<'EOF'
---
id: pages
name: Pages
summary: The screens.
layer: web
sources: [src/web]
talks_to:
  - { to: store, via: call }
---

# Pages
EOF
  cat > "$d/docs/architecture/components/store.md" <<'EOF'
---
id: store
name: Store
summary: The data.
layer: core
sources: [src/core]
---

# Store
EOF
  run "$ARCH" -C "$d" build
  [ "$status" -eq 0 ]
  [ "$(jq -c '.parts[0].modules' "$d/docs/architecture/model.json")" = '[]' ]
  [ "$(jq -r '.components[0].part, .components[0].module' "$d/docs/architecture/model.json" | paste -sd,)" = "app,null" ]
  [ "$(jq -r '.connections | length' "$d/docs/architecture/model.json")" = 1 ]
  grep -qF -- '- [Pages](components/pages.md): The screens.' "$d/docs/architecture/index.md"
}

@test "a missing architecture.md exits 2" {
  run "$ARCH" -C "$BATS_TEST_TMPDIR" build
  [ "$status" -eq 2 ]
  [[ "$output" == *"no docs/architecture"* ]]
}

@test "an unknown style id is used as its name" {
  sed -i 's/^style: .*/style: home-grown/' "$A/docs/architecture/architecture.md"
  "$ARCH" -C "$A" build
  [ "$(jq -r '.style.name' "$A/docs/architecture/model.json")" = home-grown ]
}

@test "the project catalog wins over the built-in one" {
  mkdir -p "$A/docs/architecture/catalog/styles"
  printf -- '---\nid: modular-monolith\nname: Ours\n---\n' > "$A/docs/architecture/catalog/styles/modular-monolith.md"
  "$ARCH" -C "$A" build
  [ "$(jq -r '.style.name' "$A/docs/architecture/model.json")" = Ours ]
}

@test "catalog lookup: overlay beats built-in, absent is non-zero" {
  ROOT="$A"; source "$REPO_ROOT/image/lib/wiki.sh"; source "$REPO_ROOT/image/lib/arch.sh"
  ARCH_CATALOG_BUILTIN="$BATS_TEST_TMPDIR/b" ARCH_CATALOG_OVERLAY="$BATS_TEST_TMPDIR/o"
  mkdir -p "$ARCH_CATALOG_BUILTIN/styles" "$ARCH_CATALOG_OVERLAY/styles"
  touch "$ARCH_CATALOG_BUILTIN/styles/x.md" "$ARCH_CATALOG_OVERLAY/styles/x.md"
  [ "$(arch_catalog_find style x)" = "$ARCH_CATALOG_OVERLAY/styles/x.md" ]
  run arch_catalog_find style nope
  [ "$status" -ne 0 ]
}

@test "other commands print usage and exit 2" {
  run "$ARCH" frobnicate
  [ "$status" -eq 2 ]
}
