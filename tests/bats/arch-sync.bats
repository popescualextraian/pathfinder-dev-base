#!/usr/bin/env bats
load helpers

setup() {
  make_tmp_home
  export AGENTIC_DIR="$REPO_ROOT/image"
  ARCH="$REPO_ROOT/image/bin/agentic-arch"
  arch_repo
  CI="$A/.github/copilot-instructions.md"
}

@test "sync puts the index minus its first line into a generated block" {
  run "$ARCH" -C "$A" sync
  [ "$status" -eq 0 ]
  [ "$(sed -n 1p "$CI")" = "<!-- generated:architecture-index:start -->" ]
  [ "$(tail -n 1 "$CI")" = "<!-- generated:architecture-index:end -->" ]
  diff <(sed '1d;$d' "$CI") <(tail -n +2 "$A/docs/architecture/index.md")
  ! grep -q 'Generated by agentic-arch build' "$CI"
}

@test "sync keeps the text around the block and a second run is identical" {
  mkdir -p "$A/.github"
  printf 'Be kind.\n' > "$CI"
  "$ARCH" -C "$A" sync
  [ "$(head -n 1 "$CI")" = "Be kind." ]
  cp "$CI" "$BATS_TEST_TMPDIR/first"
  printf '\nAfter the block.\n' >> "$CI"
  "$ARCH" -C "$A" sync
  grep -qxF "After the block." "$CI"
  grep -qxF "Be kind." "$CI"
  [ "$(grep -c 'architecture-index:start' "$CI")" -eq 1 ]
  "$ARCH" -C "$A" sync
  cp "$CI" "$BATS_TEST_TMPDIR/second"
  "$ARCH" -C "$A" sync
  cmp "$CI" "$BATS_TEST_TMPDIR/second"
}

@test "sync after a rebuild replaces the block content" {
  "$ARCH" -C "$A" sync
  sed -i 's/^style: modular-monolith$/style: modular-monolith/; s/^principles: \[make-it-work, /principles: [/' "$A/docs/architecture/architecture.md"
  "$ARCH" -C "$A" build
  "$ARCH" -C "$A" sync
  ! grep -q 'make-it-work' "$CI"
}

@test "sync without an index is still ok" {
  rm "$A/docs/architecture/index.md"
  run "$ARCH" -C "$A" sync
  [ "$status" -eq 0 ]
  [ ! -e "$CI" ]
}
