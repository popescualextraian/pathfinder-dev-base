#!/usr/bin/env bats
load helpers

setup() {
  WK="$REPO_ROOT/image/bin/agentic-wiki"
  wiki_repo
}

@test "build writes the index: note, overview, top-level components, concepts, flows, more" {
  rm -f "$W/docs/wiki/index.md"
  run "$WK" -C "$W" build
  [ "$status" -eq 0 ]
  i="$W/docs/wiki/index.md"
  [ "$(sed -n 1p "$i")" = '<!-- Generated by agentic-wiki build from the pages in docs/wiki/. Do not edit. -->' ]
  grep -qxF 'Shop sells items through a public HTTP API. The API keeps business logic thin and calls the' "$i"
  grep -qxF -- '- [API](components/api.md): Public HTTP API; owns the routes and their versioning.' "$i"
  grep -qxF -- '- [Common](components/common.md): Shared helpers used by more than one component.' "$i"
  grep -qxF -- '- [Money](concepts/money.md): Amounts are integer cents with an ISO currency code.' "$i"
  grep -qxF -- '- [Checkout](flows/checkout.md): From a cart to a paid order.' "$i"
  grep -qxF -- '- [Decisions](decisions/index.md), [Reuse](reuse.md), [Glossary](glossary.md)' "$i"
  run grep -F 'components/api/routes.md' "$i"
  [ "$status" -ne 0 ]
  run grep -xF '# Overview' "$i"
  [ "$status" -ne 0 ]
}

@test "build lists decisions in number order with their status" {
  printf -- '---\nid: decisions/adr-10\nkind: decision\ntitle: Ten\nstatus: proposed\n---\n' > "$W/docs/wiki/decisions/adr-10.md"
  printf -- '---\nid: decisions/adr-2\nkind: decision\ntitle: Two\nstatus: proposed\n---\n' > "$W/docs/wiki/decisions/adr-2.md"
  run "$WK" -C "$W" build
  [ "$status" -eq 0 ]
  [ "$(grep '^- ' "$W/docs/wiki/decisions/index.md")" = $'- [Versioned public routes](adr-1.md): accepted\n- [Two](adr-2.md): proposed\n- [Ten](adr-10.md): proposed' ]
}

@test "build collects the components' offers into reuse.md" {
  run "$WK" -C "$W" build
  grep -qxF '| format_money | `src/common/money.py::format_money` | Format an amount in cents with its currency for display. | [Common](components/common.md) |' "$W/docs/wiki/reuse.md"
}

@test "build writes Used by blocks from depends_on, and a second build changes nothing" {
  run "$WK" -C "$W" build
  [ "$status" -eq 0 ]
  c="$W/docs/wiki/components/common.md"
  [ "$(sed -n '/generated:used-by:start/,/generated:used-by:end/p' "$c")" = $'<!-- generated:used-by:start -->\n## Used by\n\n- [API](api.md)\n<!-- generated:used-by:end -->' ]
  run grep -q 'generated:used-by' "$W/docs/wiki/components/api.md"
  [ "$status" -ne 0 ]
  cp -r "$W/docs" "$BATS_TEST_TMPDIR/first"
  run "$WK" -C "$W" build
  diff -r "$BATS_TEST_TMPDIR/first" "$W/docs"
}

@test "build removes a Used by block when nothing depends on the component any more" {
  run "$WK" -C "$W" build
  sed -i '\#^  - components/common$#d' "$W/docs/wiki/components/api.md"
  run "$WK" -C "$W" build
  run grep -q 'generated:used-by' "$W/docs/wiki/components/common.md"
  [ "$status" -ne 0 ]
}

@test "build reproduces the committed generated files of the fixture" {
  rm "$W/docs/wiki/index.md" "$W/docs/wiki/decisions/index.md" "$W/docs/wiki/reuse.md"
  run "$WK" -C "$W" build
  [ "$status" -eq 0 ]
  diff -r "$REPO_ROOT/tests/fixtures/wiki/good/docs" "$W/docs"
}

@test "a page with CRLF line endings parses like LF" {
  sed -i 's/$/\r/' "$W/docs/wiki/concepts/money.md"
  run "$WK" -C "$W" build
  [ "$status" -eq 0 ]
  grep -qF -- '- [Money](concepts/money.md): Amounts are integer cents with an ISO currency code.' "$W/docs/wiki/index.md"
}

@test "build without docs/wiki fails with a clear message" {
  mkdir "$BATS_TEST_TMPDIR/empty"
  run "$WK" -C "$BATS_TEST_TMPDIR/empty" build
  [ "$status" -eq 2 ]
  [[ "$output" == *"no docs/wiki"* ]]
}

@test "an unknown command prints the usage" {
  run "$WK" frobnicate
  [ "$status" -eq 2 ]
  [[ "$output" == usage:* ]]
}

@test "a parent page lists its sub-components" {
  run "$WK" -C "$W" build
  [ "$(sed -n '/generated:parts:start/,/generated:parts:end/p' "$W/docs/wiki/components/api.md")" = $'<!-- generated:parts:start -->\n## Parts\n\n- [Routes](api/routes.md): The route table of the API.\n<!-- generated:parts:end -->' ]
}
