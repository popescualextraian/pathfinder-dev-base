# Copy to .agentic/.env (git-ignored) and fill in what you use. No quotes, no spaces around =.
# Git host token for git.host (credential helper, gh)
GH_TOKEN=
# Token for a GitLab host in git.hosts, referenced there as ${GITLAB_TOKEN} (scope write_repository,
# api for glab). Each further host in git.hosts names its own variable.
GITLAB_TOKEN=
# Claude, pick one (leave all three empty after `agentic login claude`):
#   subscription token from `claude setup-token` (starts with sk-ant-oat)
CLAUDE_CODE_OAUTH_TOKEN=
#   pay-per-use API key from the Anthropic console (starts with sk-ant-api); never a subscription token
ANTHROPIC_API_KEY=
#   Bedrock: set to 1 and set AWS_PROFILE below
CLAUDE_CODE_USE_BEDROCK=
# Copilot: leave empty after `agentic login copilot`, or a token
COPILOT_GITHUB_TOKEN=
# AWS profile from ~/.aws to pass into the container
AWS_PROFILE=
# Atlassian MCP
JIRA_PERSONAL_TOKEN=
CONFLUENCE_PERSONAL_TOKEN=
