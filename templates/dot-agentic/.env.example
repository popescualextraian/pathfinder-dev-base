# Copy to .agentic/.env (git-ignored) and fill in what you use. No quotes, no spaces around =.
# Every variable here reaches every process in the container (docker --env-file), so tools that
# read their own variables (git, gh, glab, aws, npm, ...) need nothing else.
# GitHub token for gh (and Copilot); the first clone of AGENTIC_REPO_URL also uses it, or GIT_TOKEN
GH_TOKEN=
# Git identity: commits need author and committer (the host's git identity is used when empty)
#GIT_AUTHOR_NAME=Jane Doe
#GIT_AUTHOR_EMAIL=jane@example.com
#GIT_COMMITTER_NAME=Jane Doe
#GIT_COMMITTER_EMAIL=jane@example.com
# GitHub Enterprise host for gh and Copilot
#GH_HOST=github.example.com
# Git push over https: git reads GIT_CONFIG_* natively. The helper names the token variable; git
# expands it when it runs, so the token is stored once. Number entries from 0, COUNT = how many.
# Username: oauth2 for GitLab, x-access-token for GitHub. One username + helper pair per host.
#GITLAB_TOKEN=
#GIT_CONFIG_COUNT=2
#GIT_CONFIG_KEY_0=credential.https://gitlab.example.com.username
#GIT_CONFIG_VALUE_0=oauth2
#GIT_CONFIG_KEY_1=credential.https://gitlab.example.com.helper
#GIT_CONFIG_VALUE_1=!f() { echo "password=$GITLAB_TOKEN"; }; f
# Claude, pick one (leave all three empty after `agentic login claude`):
#   subscription token from `claude setup-token` (starts with sk-ant-oat)
CLAUDE_CODE_OAUTH_TOKEN=
#   pay-per-use API key from the Anthropic console (starts with sk-ant-api); never a subscription token
ANTHROPIC_API_KEY=
#   Bedrock: set to 1 and set AWS_PROFILE below
CLAUDE_CODE_USE_BEDROCK=
# Copilot: leave empty after `agentic login copilot`, or a token
COPILOT_GITHUB_TOKEN=
# Models (empty: the harness default)
#ANTHROPIC_MODEL=
#COPILOT_MODEL=
# AWS: the profile name; bring ~/.aws in with: agentic mount ~/.aws /home/dev/.aws --readonly
#AWS_PROFILE=
# MCP servers read their tokens from here: agentic add mcp NAME --env TOKEN_NAME -- COMMAND
